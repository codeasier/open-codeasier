{
  "name": "open-codeasier",
  "version": "0.2.1",
  "description": "OpenCode-native workflow skills and review orchestration tools",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "skills",
    "commands",
    "agents",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "open-codeasier": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./server": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run workflows:check && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "workflows:generate": "node scripts/generate-workflows.mjs --platform opencode --target .",
    "workflows:check": "node scripts/check-workflows.mjs --platform opencode --target ."
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.14.49",
    "@opencode-ai/sdk": "1.14.49"
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@types/node": "22.15.32",
    "eslint": "9.30.1",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.0",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22",
    "opencode": ">=1.14.49"
  }
}
